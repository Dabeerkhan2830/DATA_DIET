# Copy this file to `.env` for local development and fill in real values.
#   Copy-Item .env.example .env
#
# NEVER commit `.env` — it is git-ignored. Never put database credentials, API
# keys, or privileged tokens in frontend code or in VITE_* variables: anything
# prefixed with VITE_ is embedded in the browser bundle.

# --- Application ------------------------------------------------------------
# development | test | production
ENVIRONMENT=development

# --- Authentication & authorization (Phase 7, ADR-0014) ---------------------
# DataDiet stores NO passwords: there is a directory of accounts, and bearer
# tokens (HS256) prove which one is calling. Authorization always comes from the
# directory, never from token claims.
#
# Leave AUTH_JWT_SECRET EMPTY in development: a well-known development value is
# used automatically and `POST /api/v1/auth/dev-login` signs synthetic accounts
# in. That development convenience is forcibly disabled in production.
#
# In ENVIRONMENT=production you MUST set a real secret (>= 32 characters) or
# every authenticated endpoint returns 503. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_JWT_SECRET=
# Issuer/audience must match whoever issues tokens. NOTE: this API verifies
# HS256 only — RS256/JWKS support is not implemented, so an OIDC provider that
# signs with RS256 cannot be used yet (ADR-0014).
AUTH_JWT_ISSUER=datadiet-dev
AUTH_JWT_AUDIENCE=datadiet-api
# Token lifetime in seconds (60..86400).
AUTH_TOKEN_TTL_SECONDS=3600
# Development/test sign-in only. ALWAYS false in production (ignored there).
AUTH_DEV_PROVIDER_ENABLED=true

# --- Backend API ------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated list of allowed browser origins (frontend dev server).
CORS_ORIGINS=http://localhost:5173

# Phase 1: serve synthetic demo endpoints (/api/v1/demo/*). Set to false to
# disable them — they are not real data, but they should not exist in production.
DEMO_DATA_ENABLED=true

# --- Phase 4: controlled data ingestion -------------------------------------
# Allow-listed local directories a `local_folder` source may scan, as a JSON
# object of key -> absolute path. The API only accepts a KEY, never a path, and
# resolves it here. Empty by default: local-folder sources stay disabled until
# an operator opts in. Never scan a whole drive, home directory, or the repo.
#   LOCAL_SOURCE_ROOTS={"dev-fixtures":"C:/Users/you/datadiet-fixtures"}
LOCAL_SOURCE_ROOTS={}
# Hard ceiling on records a single scan may ingest (bounds work per scan).
SCAN_MAX_RECORDS=5000
# Default discovery batch size when a scan does not override it.
SCAN_BATCH_SIZE=500

# --- Database (MySQL) -------------------------------------------------------
# SQLAlchemy URL. Development default matches infra/docker-compose.dev.yml.
DATABASE_URL=mysql+pymysql://datadiet:datadiet_dev_password@localhost:3306/datadiet
# Log SQL statements (development only; very noisy).
DATABASE_ECHO=false

# Values consumed by infra/docker-compose.dev.yml (informational here).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=datadiet
MYSQL_USER=datadiet
MYSQL_PASSWORD=datadiet_dev_password

# --- Frontend ---------------------------------------------------------------
# Leave EMPTY in development: the Vite dev server proxies /api to the backend,
# so no CORS setup is needed. In deployed environments set the public API origin,
# e.g. VITE_API_BASE_URL=https://datadiet.example.edu
VITE_API_BASE_URL=

# --- Phase 2+ placeholders (NOT used yet) -----------------------------------
# These integrations do not exist yet. Do not add values until implemented.
# SMTP_HOST=
# NOTIFICATION_WEBHOOK_URL=
# OBJECT_STORAGE_BACKEND=local
