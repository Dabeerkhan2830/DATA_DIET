# --- Local data (never commit real data) ---
local_storage/
storage/
*.local.db
# Re-include one path: `storage/` above is a *data* rule and matches at any
# depth, so it also hid `backend/app/services/storage/` — Phase 6.x's source
# package (ADR-0026), which contains code and no data. The exception is pinned
# to that exact directory, so every other `storage/` anywhere in the tree stays
# ignored; nothing that is meant to hold real data belongs under this path.
!backend/app/services/storage/

# --- Local scratch artifacts (redesign baseline, 2026-11-01) ---
# pytest scratch databases under backend/ (test.db, tmp_test*.db, ...)
backend/*.db
*.db-journal
# captured test output at the repo root
pytest_out.txt
